# Export these variables in the shell; the application does not load .env files.
PYTHON_HOST=127.0.0.1
PYTHON_PORT=8001
MODEL_MODE=heuristic
ALLOW_MODEL_FALLBACK=true
# Trusted local artifacts only; sibling <stem>.metadata.json is mandatory.
LANDSLIDE_MODEL_PATH=
FLOOD_MODEL_PATH=
# Optional expected trained model version.
MODEL_VERSION=
LOG_LEVEL=info
MAX_REQUEST_BYTES=1048576
