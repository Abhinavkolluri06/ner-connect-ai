# Copy to .env. scripts/start-backend.ps1 loads it; Docker Compose reads it too.
# Do not commit .env. Public providers below are for non-commercial demos.
NER_ENV=development
NER_DEMO_MODE=false
GO_HOST=127.0.0.1
GO_PORT=8080
PYTHON_HOST=127.0.0.1
PYTHON_PORT=8001
PYTHON_SERVICE_URL=http://127.0.0.1:8001
PYTHON_TIMEOUT_SECONDS=5
MODEL_MODE=heuristic
ALLOW_MODEL_FALLBACK=true
ROUTING_PROVIDER=osrm
ROUTING_SERVICE_URL=https://router.project-osrm.org
# For dimension-aware truck routing use ROUTING_PROVIDER=ors and
# ROUTING_SERVICE_URL=https://api.openrouteservice.org with your MAP_API_KEY.
MAP_API_KEY=
WEATHER_PROVIDER=openmeteo
WEATHER_SERVICE_URL=https://api.open-meteo.com
TERRAIN_URL=https://api.open-meteo.com
GEOCODING_URL=https://geocoding-api.open-meteo.com
WEATHER_API_KEY=
# Default is transactional local disk. Set DATABASE_URL for PostgreSQL.
DATABASE_URL=
DATA_PATH=data/ner-connect.db
# Optional validated feed, local file OR URL. An expired configured feed blocks routing.
ROAD_HAZARD_DATA_PATH=
ROAD_HAZARD_DATA_URL=
CORS_ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=info
# Required (>=32 random characters) for Docker, non-loopback or production.
# Service-wide credential, NOT individual user authentication.
API_TOKEN=
# Docker only. Generate a different random password for the database.
POSTGRES_PASSWORD=
# Optional local executable overrides for the PowerShell startup script.
GO_EXECUTABLE=go
PYTHON_EXECUTABLE=python
